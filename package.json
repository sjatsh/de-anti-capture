  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "icon": "electron tools/render-icon.js",
    "native-test": "node test/native-test.js",
    "build:dll": "cmd /c .\\build.bat",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "sjatsh <admin@sjis.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjatsh/de-anti-capture.git"
  },
  "homepage": "https://github.com/sjatsh/de-anti-capture#readme",
  "bugs": {
    "url": "https://github.com/sjatsh/de-anti-capture/issues"
  },
  "dependencies": {
