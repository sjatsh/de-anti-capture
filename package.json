{
  "name": "de-anti-capture",
  "productName": "窗口保活与API拦截工具",
  "version": "2.0.0",
  "description": "窗口保活与 Win32 API 拦截工具（Electron + koffi + 注入式 Hook DLL）",
  "main": ".vite/build/index.js",
  "scripts": {
    "start": "electron-forge start",
    "package": "electron-forge package",
    "make": "electron-forge make",
    "icon": "electron -r tsx/cjs scripts/render-icon.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -p tsconfig.json --noEmit && tsc -p tsconfig.node.json --noEmit && tsc -p tsconfig.test.json --noEmit",
    "build:dll": "cmd /c .\\scripts\\build.bat",
    "lint": "eslint .",
    "lint:fix": "eslint . --fix",
    "format": "prettier --write .",
    "format:check": "prettier --check ."
  },
  "author": "sjatsh <admin@sjis.me>",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/sjatsh/de-anti-capture.git"
  },
  "homepage": "https://github.com/sjatsh/de-anti-capture#readme",
  "bugs": {
    "url": "https://github.com/sjatsh/de-anti-capture/issues"
  },
  "dependencies": {
    "koffi": "^3.0.2"
  },
  "devDependencies": {
    "@electron-forge/cli": "^7.6.0",
    "@electron-forge/maker-squirrel": "^7.6.0",
    "@electron-forge/maker-zip": "^7.6.0",
    "@electron-forge/plugin-vite": "^7.6.0",
    "@eslint/js": "^9.16.0",
    "@types/node": "^22.20.0",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^4.7.0",
    "electron": "^40.10.3",
    "eslint": "^9.16.0",
    "eslint-plugin-react-hooks": "^5.2.0",
    "eslint-plugin-react-refresh": "^0.4.26",
    "globals": "^15.13.0",
    "prettier": "^3.4.2",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsx": "^4.22.4",
    "typescript": "^5.9.3",
    "typescript-eslint": "^8.62.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.9",
    "zustand": "^5.0.14"
  }
}
