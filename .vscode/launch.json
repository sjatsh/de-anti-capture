{
  "version": "0.2.0",
  "configurations": [
    {
      "name": "Forge: 主进程",
      "type": "node",
      "request": "launch",
      "cwd": "${workspaceFolder}",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["run", "start", "--", "--inspect-electron"],
      "console": "integratedTerminal",
      "skipFiles": ["<node_internals>/**"]
    },
    {
      "name": "Forge: 渲染层",
      "type": "chrome",
      "request": "attach",
      "port": 9222,
      "webRoot": "${workspaceFolder}/src/renderer",
      "timeout": 30000
    }
  ],
  "compounds": [
    {
      "name": "Forge: 主进程 + 渲染层",
      "configurations": ["Forge: 主进程", "Forge: 渲染层"]
    }
  ]
}
